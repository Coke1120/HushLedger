{
  "name": "hushledger",
  "private": true,
  "version": "0.1.0-beta.2",
  "description": "Open-source privacy-first multilingual personal finance PWA and expense tracker with recurring transactions on Cloudflare Workers and D1.",
  "keywords": [
    "personal-finance",
    "expense-tracker",
    "money-manager",
    "income-tracker",
    "recurring-transactions",
    "privacy-first",
    "self-hosted",
    "pwa",
    "react",
    "typescript",
    "cloudflare-workers",
    "cloudflare-d1",
    "multilingual",
    "internationalization",
    "localization"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Coke1120/HushLedger.git"
  },
  "bugs": {
    "url": "https://github.com/Coke1120/HushLedger/issues"
  },
  "homepage": "https://github.com/Coke1120/HushLedger#readme",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "type": "module",
  "scripts": {
    "dev": "node -r ./scripts/private-local-state.cjs ./node_modules/next/dist/bin/next dev --hostname 127.0.0.1",
    "build": "next build",
    "build:cloudflare": "opennextjs-cloudflare build",
    "deploy": "npm run build:cloudflare && opennextjs-cloudflare deploy",
    "lint": "eslint . --max-warnings 0 && oxlint --deny-warnings",
    "lint:fast": "oxlint --deny-warnings",
    "preview": "npm run build:cloudflare && node -r ./scripts/private-local-state.cjs ./node_modules/wrangler/bin/wrangler.js dev",
    "test": "tsx --test src/**/*.test.ts worker/*.test.ts && node --test scripts/private-local-state.test.cjs",
    "test:integration": "node scripts/worker-integration.mjs",
    "typecheck": "tsc --noEmit --pretty false",
    "types:worker": "wrangler types",
    "verify": "npm test && npm run typecheck && npm run types:worker -- --check && npm run lint && npm run build && npm run build:cloudflare && npm run test:integration -- --skip-build",
    "db:local": "node -r ./scripts/private-local-state.cjs ./node_modules/wrangler/bin/wrangler.js d1 migrations apply hushledger --local"
  },
  "dependencies": {
    "jose": "^6.2.3",
    "lucide-react": "^1.24.0",
    "next": "^16.2.12",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260711.1",
    "@opennextjs/cloudflare": "^1.20.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "oxlint": "^1.71.0",
    "tsx": "^4.23.0",
    "typescript": "~6.0.2",
    "wrangler": "^4.110.0"
  },
  "overrides": {
    "postcss": "8.5.17",
    "workerd": "1.20260712.1"
  }
}
