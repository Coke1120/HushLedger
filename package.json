{
  "name": "hushledger",
  "private": true,
  "version": "0.1.0-beta.4",
  "description": "Open-source privacy-first multilingual personal finance PWA and expense tracker with recurring transactions on Cloudflare Workers and D1.",
  "keywords": [
    "personal-finance",
    "expense-tracker",
    "money-manager",
    "income-tracker",
    "recurring-transactions",
    "privacy-first",
    "self-hosted",
    "pwa",
    "react",
    "typescript",
    "cloudflare-workers",
    "cloudflare-d1",
    "multilingual",
    "internationalization",
    "localization"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Coke1120/HushLedger.git"
  },
  "bugs": {
    "url": "https://github.com/Coke1120/HushLedger/issues"
  },
  "homepage": "https://github.com/Coke1120/HushLedger#readme",
  "engines": {
    "node": "^22.13.0 || >=24.0.0",
    "npm": ">=10"
  },
  "type": "module",
  "scripts": {
    "dev": "node -r ./scripts/private-local-state.cjs ./node_modules/next/dist/bin/next dev --hostname 127.0.0.1",
    "build": "next build",
    "build:cloudflare": "opennextjs-cloudflare build",
    "deploy": "npm run build:cloudflare && opennextjs-cloudflare deploy",
    "lint": "eslint . --max-warnings 0 && oxlint --deny-warnings",
    "lint:fast": "oxlint --deny-warnings",
    "preview": "npm run build:cloudflare && node -r ./scripts/private-local-state.cjs ./node_modules/wrangler/bin/wrangler.js dev",
    "test": "tsx --import ./scripts/load-test-locales.ts --test src/**/*.test.ts worker/*.test.ts && node --test scripts/private-local-state.test.cjs scripts/macos-package.test.mjs",
    "test:integration": "node scripts/worker-integration.mjs",
    "typecheck": "tsc --noEmit --pretty false",
    "types:worker": "wrangler types --env-file ./scripts/worker-types.env",
    "verify": "npm test && npm run typecheck && npm run types:worker -- --check && npm run lint && npm run build:cloudflare && npm run test:integration -- --skip-build",
    "db:local": "node -r ./scripts/private-local-state.cjs ./node_modules/wrangler/bin/wrangler.js d1 migrations apply hushledger --local",
    "package:macos": "node scripts/package-macos.mjs",
    "archive:macos": "node scripts/archive-macos.mjs",
    "smoke:macos": "node scripts/smoke-macos.mjs",
    "test:macos": "node --test desktop/macos/*.test.mjs scripts/macos-package.test.mjs"
  },
  "dependencies": {
    "jose": "^6.2.13",
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261028.1",
    "@opennextjs/cloudflare": "^1.20.13",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "oxlint": "^1.89.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "10.5.0"
    },
    "postcss": "8.5.31",
    "workerd": "1.20261019.1",
    "miniflare@5.20261019.2-beta": {
      "undici": "7.30.1"
    }
  }
}
